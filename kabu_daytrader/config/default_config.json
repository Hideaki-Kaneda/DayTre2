{
  "watchlist_size": 30,
  "shares_per_symbol": 100,
  "trailing_multiplier": 2.0,
  "reentry_cooldown_bars": 3,
  "bar_interval_minutes": 5,
  "pg_config_path": "C:\\Users\\kaneda\\ClaudeCode\\minute_data_import\\config.ini",
  "daily_profit_target": 20000,
  "daily_max_loss": 20000,
  "force_close_time": "15:00",
  "entry_start_time": "09:12",
  "push_reconnect_max_retry": 3,
  "indicators": {
    "rsi6": {"type": "rsi", "period": 6},
    "macd": {"type": "macd", "fast_period": 7, "slow_period": 26, "signal_period": 7},
    "dmi": {"type": "dmi", "di_period": 6, "adx_period": 14}
  },
  "entry_rule": {
    "operator": "AND",
    "conditions": [
      {"indicator": "rsi6", "field": "rsi6", "op": "<", "value": 35},
      {"indicator": "macd", "field": "macd", "op": "<", "value": 0},
      {"indicator": "macd", "field": "dea", "op": "<", "value": -10},
      {"indicator": "dmi", "field": "adx", "op": ">", "value": 50},
      {"indicator": "dmi", "field": "pdi", "op": "<", "value": "dmi.mdi"}
    ]
  },
  "exit_rule": {
    "operator": "AND",
    "conditions": [
      {"indicator": "rsi6", "field": "rsi6", "op": "<", "value": 65},
      {
        "operator": "OR",
        "conditions": [
          {"indicator": "macd", "field": "macd_crossed_up", "op": "==", "value": true},
          {"indicator": "macd", "field": "dif_crossed_dea_up", "op": "==", "value": true}
        ]
      },
      {"indicator": "dmi", "field": "adx", "op": ">", "value": 50},
      {"indicator": "dmi", "field": "pdi", "op": "<", "value": "dmi.mdi"}
    ]
  }
}
